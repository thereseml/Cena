# Server-only configuration. Never commit real credentials.
# For local PostgreSQL use a direct connection. For Supabase, use the
# session-pooler connection string for the API and the direct
# database connection when running migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/cena?schema=public"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/cena?schema=public"
# Supabase Auth issuer and asymmetric JWT signing key endpoint.
SUPABASE_JWT_ISSUER="https://your-project.supabase.co/auth/v1"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_AUDIENCE="authenticated"
PORT=3000

# Food photo recognition. Workers AI must remain on the free Workers allocation.
FOOD_RECOGNITION_PROVIDER=cloudflare
FOOD_RECOGNITION_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FOOD_RECOGNITION_TIMEOUT_MS=60000
FOOD_RECOGNITION_MAX_IMAGE_BYTES=5242880
