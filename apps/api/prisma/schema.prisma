generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum InventoryUnit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
}

enum StorageLocation {
  FRIDGE
  FREEZER
  PANTRY
}

enum ExpiryType {
  BEST_BEFORE
  USE_BY
}

enum ExpirySource {
  USER_ENTERED
  ESTIMATED
}

enum InventoryEventType {
  ADDED
  PURCHASED
  ADJUSTED
  REMOVED
  DISCARDED
  CONSUMED
}

model User {
  id                    String            @id @default(uuid()) @db.Uuid
  supabaseAuthId        String            @unique @map("supabase_auth_id") @db.Uuid
  email                 String
  provisioningCompleted Boolean           @default(false) @map("provisioning_completed")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  memberships           HouseholdMember[]

  @@map("users")
}

model Ingredient {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique @map("normalized_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  products       Product[]

  @@map("ingredients")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  ingredientId   String          @map("ingredient_id") @db.Uuid
  name           String
  normalizedName String          @unique @map("normalized_name")
  defaultUnit    InventoryUnit?  @map("default_unit")
  createdAt      DateTime        @default(now()) @map("created_at")
  ingredient     Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  @@index([ingredientId])
  @@map("products")
}

model InventoryItem {
  id              String           @id @default(uuid()) @db.Uuid
  householdId     String           @map("household_id") @db.Uuid
  createRequestId String           @map("create_request_id")
  productId       String           @map("product_id") @db.Uuid
  displayName     String           @map("display_name")
  unit            InventoryUnit
  storageLocation StorageLocation  @map("storage_location")
  archivedAt      DateTime?        @map("archived_at")
  version         Int              @default(0)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  household       Household        @relation(fields: [householdId], references: [id], onDelete: Restrict)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  batches         ProductBatch[]
  events          InventoryEvent[]

  @@unique([householdId, createRequestId])
  @@index([householdId, archivedAt, storageLocation])
  @@index([productId])
  @@map("inventory_items")
}

model ProductBatch {
  id              String           @id @default(uuid()) @db.Uuid
  inventoryItemId String           @map("inventory_item_id") @db.Uuid
  quantity        Decimal          @db.Decimal(12, 3)
  expiryDate      DateTime?        @map("expiry_date") @db.Date
  expiryType      ExpiryType?      @map("expiry_type")
  expirySource    ExpirySource?    @map("expiry_source")
  createdAt       DateTime         @default(now()) @map("created_at")
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  events          InventoryEvent[]

  @@index([inventoryItemId])
  @@index([expiryDate])
  @@map("product_batches")
}

model InventoryEvent {
  id              String             @id @default(uuid()) @db.Uuid
  householdId     String             @map("household_id") @db.Uuid
  inventoryItemId String             @map("inventory_item_id") @db.Uuid
  productBatchId  String?            @map("product_batch_id") @db.Uuid
  eventType       InventoryEventType @map("event_type")
  quantityDelta   Decimal            @map("quantity_delta") @db.Decimal(12, 3)
  unit            InventoryUnit
  createdAt       DateTime           @default(now()) @map("created_at")
  household       Household          @relation(fields: [householdId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  productBatch    ProductBatch?      @relation(fields: [productBatchId], references: [id], onDelete: Restrict)

  @@index([householdId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@map("inventory_events")
}

model Household {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  members         HouseholdMember[]
  inventoryItems  InventoryItem[]
  inventoryEvents InventoryEvent[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@index([householdId])
  @@map("household_members")
}
