{
  "expo": {
    "name": "Cena",
    "slug": "cena",
    "scheme": "cena",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "se.cena.app",
      "supportsTablet": true
    },
    "android": {
      "package": "se.cena.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F0"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cena behöver använda kameran när du väljer att fotografera ett kvitto.",
          "photosPermission": "Välj en kvittobild som Cena kan läsa på din enhet.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
