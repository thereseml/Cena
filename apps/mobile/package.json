{
  "name": "@cena/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "storybook": "STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "STORYBOOK_ENABLED=true expo start --ios",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "build": "expo export --platform all",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@cena/ui": "workspace:*",
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.7.1",
    "@storybook/addon-ondevice-controls": "10.7.1",
    "@storybook/react-native": "10.7.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "storybook": "10.6.6",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  }
