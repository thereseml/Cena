  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.7.1",
    "@storybook/addon-ondevice-controls": "10.7.1",
    "@storybook/react-native": "10.7.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "storybook": "10.6.6",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
